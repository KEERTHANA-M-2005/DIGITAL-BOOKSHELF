{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "YOUR_RENDER_BACKEND_URL/api/$1"
    }
  ],
  "builds": [
    {
      "src": "client/index.html",
      "use": "@vercel/static-build",
      "config": { "distDir": "client/dist" }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "client/$1"
    }
  ]
}

